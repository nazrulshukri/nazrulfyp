{
  "installCommand": "cd .. && npm install",
  "buildCommand": "cd .. && npm run build && rm -rf src/build && cp -r build src/build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  }
}
